# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Task 2 reconciliation output — generated by `python -m src`, reproducible.
reconciliation/out/

# Node / Vite (the dashboard also has its own .gitignore)
node_modules/
dist/
*.local

# The analysis payload is a build input and IS committed:
#   betflow/dashboard/src/data/payload.json
# It is regenerated by the pipeline; keeping it in the tree lets the dashboard
# build on GitHub Pages without running Python in CI.

# Tooling caches (contain local absolute paths — not project content)
.impeccable/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Raw data exports are large and may be confidential — keep them out of git.
data/raw/

# Parsed-export cache (derived from data/raw/*.xlsx, rebuilt on demand)
*.cache.pkl

# Generated streaming artifacts (rebuilt by the refresh job)
streaming/out/
